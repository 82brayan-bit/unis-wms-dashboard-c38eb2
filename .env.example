# PostgreSQL connection string injected by Coolify in production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# App runtime
PORT=8080
APP_PUBLIC_URL=https://unis-wms-dashboard-c38eb2.coolify.item.pub

# Optional live-presence tracker origin. The browser presence collector reads
# this from the same-origin /api/runtime-config endpoint and reports the
# session (bearer token, per-tab session UUID, selected facility) to
# {origin}/api/presence/session-start|heartbeat|session-end. Leave empty to
# disable collection entirely. Never include credentials, paths or keys here;
# only the normalized http(s) origin (trailing slash stripped) is exposed.
PRESENCE_TRACKER_BASE_URL=

# Ticket integration (set in Coolify if required)
TICKET_API_HOST=unisticket.item.com
TICKET_API_BASE_PATH=/api/item-tickets
TICKET_TENANT_ID=LT
TICKET_API_KEY=

# Optional SMTP notification settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=

# Robot Count warehouse inventory integration
ROBOT_COUNT_API_URL=https://pget47t1vc.execute-api.us-west-2.amazonaws.com/prd/download_object
ROBOT_COUNT_API_KEY=

# Official GIS (warehouse map) read-only integration.
# The dashboard proxies only allow-listed read endpoints from gis.item.com;
# the user's Authorization/cookies are forwarded server-to-server.
GIS_API_HOST=gis.item.com
# The external GIS upstream requires an /api prefix on every route. Applied
# only at the transport boundary; browser proxy URLs stay /api/proxy/gis/...
GIS_API_BASE_PATH=/api
# GIS_API_PROTOCOL=http and GIS_API_PORT are supported only for local tests
# against a mock upstream; production always uses https on the default port.
GIS_API_PORT=
